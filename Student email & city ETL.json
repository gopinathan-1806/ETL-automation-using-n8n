    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean this student enrollment row.\n\nStudent ID: {{ $json.Student_ID }}\nName: {{ $json.Name }}\nEmail: {{ $json.Email }}\nPhone: {{ $json.Phone }}\nCourse: {{ $json.Course }}\nFee Paid: {{ $json.Fee_Paid }}\nCity: {{ $json.City }}\nEnrolled Date: {{ $json.Enrolled_Date }}\n\nRules:\n- Name: Title Case\n- Email: if invalid set INVALID_EMAIL\n- Phone: if less than 10 digits set MISSING\n- Course: only Python, Machine Learning, or Data Science\n- Fee_Paid: yes/YES = true, no/NO = false\n- City: Title Case, empty = UNKNOWN\n- Enrolled_Date: YYYY-MM-DD\n\nReturn ONLY raw JSON.",
        "hasOutputParser": true,
        "batching": {}
      },
