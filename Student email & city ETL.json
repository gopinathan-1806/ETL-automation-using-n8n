    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  let rawText = item.json.text || '';\n  \n  // Clean potential markdown code blocks returned by AI models\n  rawText = rawText.replace(/```json\\s*/gi, '').replace(/```/g, '').trim();\n\n  let parsedJson = {};\n  \n  try {\n    parsedJson = JSON.parse(rawText);\n  } catch (error) {\n    // Return error details if an item fails to parse\n    parsedJson = {\n      parse_error: true,\n      error_message: error.message,\n      raw_text: item.json.text\n    };\n  }\n\n  return {\n    json: parsedJson\n  };\n});"
      },
